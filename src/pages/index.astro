---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { site, specialties } from '../data/site';
import { getProjects } from '../data/projects';
import ArrowRight from '@lucide/astro/icons/arrow-right';

const projects = await getProjects();
// Projets mis en avant, dans l'ordre choisi (featuredOrder), complétés si besoin par les suivants
const picked = projects.filter((p) => p.data.featured).sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99));
const featured = [...picked, ...projects.filter((p) => !p.data.featured)].slice(0, 6);
const [first, last] = site.name.split(' ');
---
<BaseLayout page="page-home">
  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="hero-film" aria-hidden="true">
      <video muted loop playsinline preload="none" poster="/videos/my-creative-city-fond.jpg" tabindex="-1">
        <source src="/videos/my-creative-city-fond.mp4" type="video/mp4" />
      </video>
    </div>
    <p class="kicker" data-reveal>{site.role}</p>
    <h1 id="hero-title" class="hero-name" data-name aria-label={site.name}>
      <span class="word" aria-hidden="true">{first}</span> <span class="word" aria-hidden="true">{last}</span>
    </h1>
    <div class="hero-row">
      <p class="hero-hook" data-reveal>Je transforme les idées en <span>expériences visuelles.</span></p>
      <div class="hero-ctas" data-reveal>
        <a class="btn" href="/realisations/">Voir les réalisations <span class="btn-ico"><ArrowRight size={18} aria-hidden="true" /></span></a>
        <a class="btn btn--ghost" href="/videos/my-creative-city.mp4" data-film-link>Voir le film <span class="btn-meta">1 min 20</span></a>
      </div>
    </div>
    <ul class="skills" aria-label="Spécialités">
      {specialties.map((s) => (
        <li data-reveal><a href={`/realisations/?f=${s.id}`}><small>{s.time}</small>{s.label}</a></li>
      ))}
    </ul>
  </section>

  <dialog class="film-dialog" id="film" aria-label="Film My Creative City" data-film-dialog>
    <button type="button" class="film-close" data-film-close aria-label="Fermer le film">×</button>
    <video controls playsinline preload="none" poster="/videos/my-creative-city-affiche.jpg" data-film-player>
      <source src="/videos/my-creative-city.mp4" type="video/mp4" />
      Votre navigateur ne lit pas cette vidéo : <a href="/videos/my-creative-city.mp4">la télécharger</a>.
    </video>
  </dialog>

  <section class="wrap section" aria-labelledby="sel-title">
    <div class="section-head">
      <h2 id="sel-title" class="display">Sélection</h2>
      <span class="meta">{featured.length} projets</span>
    </div>
    <div class="featured">
      {featured.map((p, i) => <ProjectCard project={p} index={i} eager={i === 0} sizes="(max-width: 900px) 100vw, 33vw" />)}
    </div>
    <div class="home-more">
      <a class="btn" href="/realisations/">Toutes les réalisations <span class="btn-ico"><ArrowRight size={18} aria-hidden="true" /></span></a>
    </div>
  </section>

  <ContactBand />
</BaseLayout>
