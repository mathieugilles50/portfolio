---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page introuvable" noindex>
  <div class="wrap notfound">
    <p class="kicker">Erreur 404</p>
    <h1 class="display">Hors champ</h1>
    <p style="margin-top:20px;max-width:46ch">Cette page n'existe pas ou a été déplacée.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:28px">
      <a class="btn btn--acc" href="/">Retour à l'accueil</a>
      <a class="btn btn--ghost" href="/realisations/">Voir les réalisations</a>
    </div>
  </div>
</BaseLayout>
